// Firestore security rules for EstimateCards.
//
// Model:
// - Anonymous Auth gives every browser session a stable Firebase uid.
// - A user becomes a room participant when a matching participant document exists.
// - Room internals are readable only by joined participants.
// - Public room-code lookup exposes only a code -> session id mapping.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isFacilitator(session) {
      return isAuthed() && session.data.facilitatorUid == request.auth.uid;
    }

    function isSelf(uid) {
      return isAuthed() && uid == request.auth.uid;
    }

    function isParticipant(sessionId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid));
    }

    function isPlayer(sessionId) {
      return isParticipant(sessionId)
        && getParticipant(sessionId).data.role in ['player', 'facilitator'];
    }

    function isValidNickname(nickname) {
      return nickname is string
        && nickname.size() > 0
        && nickname.size() <= 40;
    }

    function isValidSessionName(name) {
      return name == null
        || (name is string && name.size() <= 80);
    }

    function isValidDeck(deck) {
      return deck is map
        && deck.keys().hasOnly(['id', 'values'])
        && deck.id == 'fibonacci'
        && deck.values == [1, 2, 3, 5, 8, 13, 21];
    }

    function isValidSessionCreate() {
      return request.resource.data.keys().hasOnly(['code', 'name', 'facilitatorUid', 'deck', 'createdAt', 'status'])
        && request.resource.data.code.matches('^[A-Z0-9]{5}$')
        && isValidSessionName(request.resource.data.name)
        && request.resource.data.facilitatorUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && isValidDeck(request.resource.data.deck);
    }

    function isValidSessionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeRoundId', 'status', 'name'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || request.resource.data.status in ['active', 'closed'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
            || isValidSessionName(request.resource.data.name))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeRoundId'])
            || (request.resource.data.activeRoundId is string
                && exists(/databases/$(database)/documents/sessions/$(resource.id)/rounds/$(request.resource.data.activeRoundId))));
    }

    function isValidFacilitatorParticipant(participantId) {
      return isSelf(participantId)
        && request.resource.data.keys().hasOnly(['nickname', 'role', 'joinedAt', 'connected', 'lastSeen', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'facilitator'
        && isValidNickname(request.resource.data.nickname)
        && request.resource.data.connected is bool
        && request.resource.data.joinedAt == request.time
        && request.resource.data.lastSeen == request.time;
    }

    function isValidJoinParticipant(sessionId, participantId) {
      return isSelf(participantId)
        && request.resource.data.keys().hasOnly(['nickname', 'role', 'joinedAt', 'connected', 'lastSeen', 'uid', 'joinCode'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['player', 'spectator']
        && isValidNickname(request.resource.data.nickname)
        && request.resource.data.connected is bool
        && request.resource.data.joinCode.matches('^[A-Z0-9]{5}$')
        && request.resource.data.joinedAt == request.time
        && request.resource.data.lastSeen == request.time
        && getResource(sessionId).data.status == 'active'
        && getResource(sessionId).data.code == request.resource.data.joinCode;
    }

    function isValidParticipantSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'connected', 'lastSeen', 'leftAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nickname'])
            || isValidNickname(request.resource.data.nickname))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['connected'])
            || request.resource.data.connected is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeen'])
            || request.resource.data.lastSeen == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['leftAt'])
            || !request.resource.data.keys().hasAny(['leftAt'])
            || request.resource.data.leftAt == request.time);
    }

    function isValidVote() {
      return request.resource.data.keys().hasOnly(['value', 'castAt'])
        && request.resource.data.value in [1, 2, 3, 5, 8, 13, 21, '?', '☕']
        && request.resource.data.castAt == request.time;
    }

    function isValidRoundCreate() {
      return request.resource.data.keys().hasOnly(['status', 'story', 'startedAt'])
        && request.resource.data.status == 'voting'
        && request.resource.data.startedAt == request.time
        && request.resource.data.story == null;
    }

    function isValidRoundUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revealedAt'])
        && request.resource.data.status in ['voting', 'revealed']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['revealedAt'])
            || request.resource.data.revealedAt == request.time);
    }

    function isValidRoomCodeCreate(code) {
      return isAuthed()
        && code.matches('^[A-Z0-9]{5}$')
        && request.resource.data.keys().hasOnly(['sessionId', 'createdAt', 'status'])
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && getResource(request.resource.data.sessionId).data.code == code
        && getResource(request.resource.data.sessionId).data.facilitatorUid == request.auth.uid;
    }

    match /roomCodes/{code} {
      allow get: if code.matches('^[A-Z0-9]{5}$');
      allow list: if false;
      allow create: if isValidRoomCodeCreate(code);
      allow update: if false;
      allow delete: if isFacilitator(getResource(resource.data.sessionId));
    }

    match /sessions/{sessionId} {
      allow read: if isParticipant(sessionId);

      allow create: if isAuthed() && isValidSessionCreate();
      allow update: if isFacilitator(resource) && isValidSessionUpdate();
      allow delete: if isFacilitator(resource);

      match /participants/{participantId} {
        allow read: if isParticipant(sessionId);
        allow create: if (isValidFacilitatorParticipant(participantId)
                         && getResource(sessionId).data.facilitatorUid == request.auth.uid)
                      || isValidJoinParticipant(sessionId, participantId);
        allow update: if isSelf(participantId)
                      && isParticipant(sessionId)
                      && (isValidParticipantSelfUpdate()
                          || isValidJoinParticipant(sessionId, participantId));
        allow delete: if isFacilitator(getResource(sessionId)) || isSelf(participantId);
      }

      match /rounds/{roundId} {
        allow read: if isParticipant(sessionId);

        allow create: if isFacilitator(getResource(sessionId)) && isValidRoundCreate();
        allow update: if isFacilitator(getResource(sessionId)) && isValidRoundUpdate();
        allow delete: if isFacilitator(getResource(sessionId));

        match /votes/{participantId} {
          allow read: if isParticipant(sessionId);
          allow create, update: if isSelf(participantId)
                                && isPlayer(sessionId)
                                && getRound(sessionId, roundId).data.status == 'voting'
                                && isValidVote();
          allow delete: if isFacilitator(getResource(sessionId));
        }
      }
    }

    function getResource(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId));
    }

    function getRound(sessionId, roundId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)/rounds/$(roundId));
    }

    function getParticipant(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid));
    }
  }
}
