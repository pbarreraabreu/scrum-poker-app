{
  "rules": {
    "presence": {
      "$sessionId": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.val() == null || (newData.hasChildren(['uid', 'lastSeen']) && newData.child('uid').val() == auth.uid && newData.child('lastSeen').isNumber())"
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
